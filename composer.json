{
  "name": "reportmatic/reportmatic",
  "description": "ReportMatic - Excel to report generator for internal enterprise use",
  "type": "project",
  "require": {
    "php": "^8.2",
    "dompdf/dompdf": "^2.0",
    "phpoffice/phpspreadsheet": "^1.29"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-update-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}